{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Precisa bater EXATAMENTE com o nome do projeto no painel do Cloudflare.
  "name": "debony",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",

  "assets": {
    "directory": "./site",
    "binding": "ASSETS",

    // O mirror grava páginas como `sobre-nos/index.html`, servidas em
    // `/sobre-nos/`. Este modo resolve o index do diretório.
    "html_handling": "auto-trailing-slash",

    // Sem página 404 própria no mirror: responder 404 puro é o honesto.
    "not_found_handling": "none",

    // Só a API entra no Worker. Todo o resto é servido direto pelo Asset
    // Worker, sem custo de invocação.
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true }

  // Segredos do formulário: painel do Worker (Settings > Variables and Secrets)
  // ou `wrangler secret put`:
  //   CONTACT_TO, CONTACT_FROM, RESEND_API_KEY, CONTACT_WEBHOOK (opcional)
}
