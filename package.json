{
  "name": "debony-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Clone estático de debonyusinagem.com.br para Vercel",
  "scripts": {
    "mirror": "node tools/mirror.mjs --out site --concurrency 3 --interval 300",
    "optimize": "node tools/optimize-images.mjs --out site",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.api.json",
    "build": "node tools/build.mjs --out site",
    "check": "node tools/check-links.mjs site",
    "verify": "npm run typecheck && npm run check && npm test",
    "release": "npm run mirror && npm run optimize && npm run build && npm run verify",
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "test": "node tools/test-contact.mjs",
    "test:e2e": "node tools/test-form-e2e.mjs",
    "logo": "node tools/gerar-logo.mjs",
    "test:menu": "node tools/test-menu.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.10.0",
    "sharp": "^0.35.4",
    "typescript": "^5.6.0",
    "vercel": "^59.16.0"
  }
}
